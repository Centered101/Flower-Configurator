# ============================================================
# App / Public
# ============================================================
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Flower Configurator
NEXT_PUBLIC_CREATOR_NAME=centered101

# ============================================================
# Supabase - Public client
# ใช้ค่า publishable/anon key ที่อนุญาตให้ใช้ฝั่ง browser
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ============================================================
# Supabase - Server only
# ห้ามใส่ service/secret key ใน NEXT_PUBLIC_*
# ============================================================
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=

# Legacy / fallback aliases ถ้าโปรเจกต์หรือ Supabase ใช้ชื่อเดิม
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# ============================================================
# Admin Login
# ADMIN_SESSION_SECRET ควรเป็น random string ยาว ๆ ใน production
# ============================================================
ADMIN_SESSION_SECRET=
ADMIN_FALLBACK_USERNAME=super-admin
ADMIN_FALLBACK_PASSWORD=super-admin-password
ADMIN_FALLBACK_ROLE=owner
ADMIN_EMAILS=

# ============================================================
# LINE Group Notification
# ตั้งผ่านหน้า admin ได้ด้วย ค่า env ใช้เป็น fallback
# ============================================================
LINE_CHANNEL_ACCESS_TOKEN=
LINE_ADMIN_GROUP_ID=

# ============================================================
# Payment / PromptPay
# ค่า env เป็น fallback ถ้ายังไม่ได้ตั้งผ่านหน้า admin/settings
# NEXT_PUBLIC_* ใช้ได้ฝั่ง browser, ตัวที่ไม่ขึ้นต้น NEXT_PUBLIC_* ใช้ฝั่ง server
# ============================================================
NEXT_PUBLIC_PROMPTPAY_ID=
PROMPTPAY_ID=
NEXT_PUBLIC_PAYMENT_ACCOUNT_NAME=
PAYMENT_ACCOUNT_NAME=
NEXT_PUBLIC_PAYMENT_QR_IMAGE_URL=
PAYMENT_QR_IMAGE_URL=

# ============================================================
# Slip Verification Provider (optional)
# ถ้าใช้ผู้ให้บริการตรวจสลิปจริง ให้ API รับ JSON:
# { qrPayload, orderNumber, expectedAmount, promptPayId }
# และตอบ { valid, amount, receiverMatched, message, transactionRef }
# ============================================================
SLIP_VERIFY_API_URL=
SLIP_VERIFY_API_KEY=
